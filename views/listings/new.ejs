<% layout('layouts/boilerplate') %>

<div class="row">
    <div class="col-8 mx-auto" style="background-color: #f8f9fa; padding: 2rem; border-radius: 0.5rem;">
        <h3>Create New Listing</h3><br>
        <form method="POST" action="/listings">
            <div class="mb-3">
                <label for="title" class="form-label">Title:</label>
                <input name="listing[title]" placeholder="Enter title" type="text" class="form-control">
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description:</label>
                <textarea name="listing[description]" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Image URL:</label>
                <input name="listing[image]" placeholder="Enter image URL" type="text" class="form-control">
            </div>

            <div class="row">
                <div class="mb-3 col-4">
                    <label for="price" class="form-label">Price:</label>
                    <input name="listing[price]" placeholder="Enter price" type="number" class="form-control">
                </div>

                <div class="mb-3 col-8">
                    <label for="country" class="form-label">Country:</label>
                    <input name="listing[country]" placeholder="Enter country" type="text" class="form-control">
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location:</label>
                <input name="listing[location]" placeholder="Enter location" type="text" class="form-control">
            </div>

            <button class="btn btn-dark add-btn">Add</button>
        </form>
    </div>
</div>